<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.chronit</groupId>
    <artifactId>chronit-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>chronit-driver-mcpl</artifactId>
  <name>chronit-driver-mcpl</name>
  <description>MCProtocolLib implementation of the client driver SPI (Minecraft ${minecraft.version}, protocol ${minecraft.protocol})</description>

  <dependencies>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.geysermc.mcprotocollib</groupId>
      <artifactId>protocol</artifactId>
    </dependency>
    <!--
      MCProtocolLib only brings the GSON component serializer. Chat patterns in the configuration
      are matched against what a player would see on screen, which needs the plain-text renderer.
      Version tracks the adventure release MCProtocolLib compiles against.
    -->
    <dependency>
      <groupId>net.kyori</groupId>
      <artifactId>adventure-text-serializer-plain</artifactId>
      <version>5.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
