<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.chronit</groupId>
    <artifactId>chronit-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>chronit-via</artifactId>
  <name>chronit-via</name>
  <description>Optional ViaVersion translation layer, letting the ${minecraft.version} client speak older server protocols</description>

  <!--
    Entirely optional. chronit-core has no compile-time reference to anything in here; it is
    discovered at runtime through ServiceLoader&lt;TranslationProvider&gt;. Removing this module
    from the parent POM leaves a working ${minecraft.version}-only application.
  -->
  <dependencies>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-driver-mcpl</artifactId>
    </dependency>
    <dependency>
      <groupId>net.raphimc</groupId>
      <artifactId>ViaLoader</artifactId>
      <version>${vialoader.version}</version>
    </dependency>
    <dependency>
      <groupId>com.viaversion</groupId>
      <artifactId>viaversion</artifactId>
      <version>${viaversion.version}</version>
    </dependency>
    <dependency>
      <groupId>com.viaversion</groupId>
      <artifactId>viabackwards</artifactId>
      <version>${viaversion.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
</project>
