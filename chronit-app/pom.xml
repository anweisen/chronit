<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.chronit</groupId>
    <artifactId>chronit-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>chronit-app</artifactId>
  <name>chronit-app</name>
  <description>Command line entry point and executable jar</description>

  <dependencies>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-core</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-driver-mcpl</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.chronit</groupId>
      <artifactId>chronit-web</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Opt-in legacy support: `mvn -Pvia package` bundles the ViaVersion translation layer, which
      the driver then discovers through ServiceLoader. Without this profile the jar is
      Minecraft ${minecraft.version} only and several megabytes smaller.
    -->
    <profile>
      <id>via</id>
      <dependencies>
        <dependency>
          <groupId>dev.chronit</groupId>
          <artifactId>chronit-via</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <finalName>chronit</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.chronit.app.Chronit</mainClass>
                </transformer>
                <!-- ServiceLoader registrations must be merged, not overwritten: the driver and
                     the optional Via module both contribute service files. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
