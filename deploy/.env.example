# Copy to .env beside docker-compose.yml. Docker Compose reads it automatically.
# Keep it out of version control: it holds the key that protects the stored sessions.

# Timezone for log timestamps and for any job that does not name its own.
TZ=Europe/Berlin

# --- Dashboard ------------------------------------------------------------------------------

# Hostname Traefik routes to this container.
CHRONIT_HOST=chronit.anweisen.net

# The Docker network Traefik is attached to. It must already exist — Compose will not create it,
# and `docker compose up` fails naming it if it is wrong. Check with:
#   docker network ls
TRAEFIK_NETWORK=traefik

# Required. chronit.yml reads this as ${CHRONIT_WEB_TOKEN}, and chronit refuses to start with a
# non-loopback bind and no token — which is the case as soon as Traefik is in front of it.
#
# This is the only thing between the internet and a dashboard that can start a Microsoft login and
# stop running jobs. Generate one with:  openssl rand -base64 32
CHRONIT_WEB_TOKEN=

# --- Storage --------------------------------------------------------------------------------

# Encrypts the stored Microsoft session at rest (AES-GCM). Leave empty to store it in plain text.
#
# Generate one with:  openssl rand -base64 32
#
# Keep it stable and back it up somewhere other than the server. Changing or losing it makes the
# existing token file unreadable — chronit reports that as an error rather than as a missing
# login, so it will not quietly overwrite a session that was fine, but you will have to delete the
# token file and authorise the account again.
CHRONIT_SECRET_KEY=

# INFO is right for normal running. DEBUG logs every chat line the bot sees.
CHRONIT_LOG_LEVEL=INFO
